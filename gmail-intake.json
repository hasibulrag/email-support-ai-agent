      "name": "Gmail Trigger"
    },
    {
      "parameters": {
        "jsCode": "// Runs for ALL incoming emails (one item per email) and keeps every email separate.\nconst store = $getWorkflowStaticData('global');\nstore.processed = store.processed || {};\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  const j = item.json;\n\n  const messageId = String(j.id || j.messageId || j.gmailMessageId || '');\n  const threadId = String(j.threadId || '');\n  const from = String(j.from?.value?.[0]?.address || j.from || '');\n  const subject = String(j.subject || '(No subject)');\n  const body = String(j.textPlain || j.text || j.body || j.snippet || '')\n    .replace(/<[^>]*>/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n  const injectionDetected =\n    /(ignore (all|any|previous) instructions|reveal (your|the) (system|secret)|show.*(prompt|credential|api key)|bypass.*security)/i.test(body);\n\n  const sensitiveEmail =\n    /(refund|chargeback|cancel|cancellation|complaint|lawsuit|legal|contract|payment|invoice|password|security|api key|angry|unhappy)/i.test(subject + ' ' + body);\n\n  const h = j.headers || {};\n  const isAutomated = Boolean(\n    (h['auto-submitted'] && String(h['auto-submitted']).toLowerCase() !== 'no') ||\n    /bulk|junk|list|auto_reply/i.test(String(h['precedence'] || '')) ||\n    h['list-unsubscribe'] || h['x-autoreply'] || h['x-autorespond']\n  );\n  const duplicate = Boolean(messageId && store.processed[messageId]) || isAutomated;\n\n  // remember this message so it is never processed twice\n  if (messageId && !duplicate) {\n    store.processed[messageId] = { at: new Date().toISOString() };\n  }\n\n  results.push({\n    json: {\n      ...j, messageId, threadId, from, subject, body,\n      injectionDetected, sensitiveEmail, duplicate,\n      duplicateText: duplicate ? 'true' : 'false',\n      needsHumanApproval: injectionDetected || sensitiveEmail,\n      processingStatus: 'started'\n    }\n  });\n}\n\n// forget messages older than 30 days\nfor (const key of Object.keys(store.processed)) {\n  const savedAt = store.processed[key]?.at;\n  if (savedAt && Date.now() - Date.parse(savedAt) > 30 * 24 * 60 * 60 * 1000) {\n    delete store.processed[key];\n  }\n}\n\nreturn results;\n"
      },
      "type": "n8n-nodes-base.code",
